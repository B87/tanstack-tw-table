{
  "name": "@b87/tanstack-tw-table",
  "version": "0.1.0",
  "description": "TanStack Table with shadcn/ui, server-side support, views, i18n, and framework-agnostic routing",
  "keywords": [
    "react",
    "table",
    "data-table",
    "tanstack",
    "tanstack-table",
    "shadcn",
    "shadcn-ui",
    "tailwind",
    "tailwindcss",
    "typescript",
    "server-side",
    "pagination",
    "filtering",
    "sorting",
    "virtualization",
    "i18n"
  ],
  "license": "MIT",
  "author": "b87",
  "repository": {
    "type": "git",
    "url": "https://github.com/b87/tanstack-tw-table.git"
  },
  "bugs": {
    "url": "https://github.com/b87/tanstack-tw-table/issues"
  },
  "homepage": "https://github.com/b87/tanstack-tw-table#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./routing": {
      "types": "./dist/routing/index.d.ts",
      "import": "./dist/routing/index.mjs",
      "require": "./dist/routing/index.js"
    },
    "./theme.css": "./dist/styles/theme.css",
    "./theme-v3.css": "./dist/styles/theme-v3.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup && pnpm run copy:css",
    "copy:css": "mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "prepublishOnly": "pnpm run build && pnpm run typecheck",
    "dev:demos": "pnpm --filter demo-site dev",
    "build:demos": "pnpm --filter demo-site build",
    "dev:all": "pnpm -r --parallel dev",
    "build:all": "pnpm run build && pnpm -r --filter './examples/*' build"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.10.0",
    "@tanstack/react-virtual": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^3.4.0 || ^4.0.0",
    "next": ">=13.4.0",
    "react-router-dom": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "cmdk": "^0.2.0",
    "date-fns": "^3.0.0",
    "lucide-react": "^0.294.0",
    "react-day-picker": "^9.11.1",
    "sonner": "^1.3.1",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@tanstack/react-table": "^8.10.0",
    "@tanstack/react-virtual": "^3.13.12",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/next": "^9.0.0",
    "@types/node": "^24.9.2",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "happy-dom": "^12.0.0",
    "postcss": "^8.5.6",
    "jsdom": "^24.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.0.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
